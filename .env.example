# =============================================================================
# ARMS360 — environment configuration for the microservices stack
# =============================================================================
#
# Copy to `.env` in the repository root and fill in the blanks:
#
#     cp .env.example .env
#
# `docker compose up --build -d` reads this file automatically.
#
# Anything marked REQUIRED has no safe default. Compose refuses to start
# without it rather than falling back to a guess.
#
# Generate the secrets:
#
#     openssl rand -hex 32    # JWT_ACCESS_SECRET
#     openssl rand -hex 32    # JWT_REFRESH_SECRET
#     openssl rand -hex 32    # INTERNAL_SERVICE_TOKEN
#     openssl rand -base64 24 # POSTGRES_PASSWORD
#
# Do NOT commit the populated .env. It is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# Image tags
# -----------------------------------------------------------------------------
# Every service is built and tagged with this version, so a release is
# identifiable and rollback is a matter of re-tagging a previous version.
# Bump it per deploy; CI can set it from the git SHA.
APP_VERSION=1.0.0

NODE_ENV=production
TZ=Asia/Kathmandu


# -----------------------------------------------------------------------------
# Postgres  (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_USER=erpuser
POSTGRES_DB=erpdb
# REQUIRED — no default. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# The Postgres container publishes no host port by default. To debug from the
# host, uncomment the `ports:` block in docker-compose.yml, then:
#
#     psql "postgres://erpuser:<password>@localhost:5555/erpdb"
#
# Prefer the in-container client, which needs no port at all:
#
#     docker compose exec postgres psql -U erpuser -d erpdb


# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis is only reachable on the internal `backend` network. Sessions and the
# permissions cache live here, so `appendonly yes` is enabled in compose.
# Optional password; when set, every service must receive the same value.
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# Authentication  (REQUIRED)
# -----------------------------------------------------------------------------
# All three backend processes verify the same JWT with the same secret, which is
# what lets the gateway forward a caller's Authorization header without
# re-issuing a token. If these differ, the services reject every proxied call.
#
# Names must match src/core/config/auth.config.ts exactly. Older docs used
# JWT_ACCESS_TOKEN_SECRET / JWT_REFRESH_TOKEN_SECRET — those are NOT read, and
# the app silently falls back to "change-me" if only those are set.
#
# Rotating these invalidates all sessions. Users must log in again.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=12h
JWT_REFRESH_TTL=7d

# Universal login password accepted for every role (super admin, principal,
# teacher, student). Leave EMPTY to disable — it is a superuser bypass and must
# not stay enabled in production.
MASTER_PASSWORD=


# -----------------------------------------------------------------------------
# Gateway routing
# -----------------------------------------------------------------------------
# Host port for the gateway. This is the only backend port exposed publicly.
GATEWAY_PORT=8500

# Upstream timeout for a single forwarded request, in milliseconds.
UPSTREAM_TIMEOUT_MS=15000

# Retry attempts for IDEMPOTENT requests only (GET/HEAD/OPTIONS/DELETE) on a
# 502/503/504 or transport error. POST/PUT/PATCH are never retried, because a
# duplicate attendance write or marks entry would corrupt data.
# 0 disables retries. Keep 0 or 1 for writes-heavy deployments.
UPSTREAM_RETRIES=0

# Base backoff between retries; doubled each attempt.
UPSTREAM_RETRY_BACKOFF_MS=150

# Timeout for the gateway's own probe of each service's /health.
HEALTH_PROBE_TIMEOUT_MS=2000

# Shared secret proving a request arrived through the gateway. REQUIRED.
# Generate with: openssl rand -hex 32
# The two service URLs are set in compose and should not be overridden here.
INTERNAL_SERVICE_TOKEN=


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated exact origins. The Vite/Next dev server and the public site.
# Do NOT use `*` — credentials: true is required for the httpOnly refresh_token
# cookie, and browsers reject `*` with credentials.
CORS_ORIGINS=http://localhost:8500,http://localhost:9000,https://arms360.deerwalk.edu.np


# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_PORT=9000

# Public origin of the Next.js app. Used for "Return to login" links and
# password-reset emails.
FRONTEND_URL=http://localhost:9000

# Keep NEXT_PUBLIC_API_BASE_URL empty: the browser calls the Next.js origin and
# /v1/* is rewritten server-side to the gateway, which keeps the httpOnly
# refresh_token cookie first-party and surviving a hard reload.
#
# NEXT_PUBLIC_BACKEND_BASE_URL is the BROWSER-VISIBLE gateway origin used to
# resolve backend-relative media URLs (e.g. http://localhost:8500 locally, or
# https://arms360-backend.deerwalk.edu.np behind the reverse proxy). It is
# inlined at BUILD time, so rebuild the frontend image after changing it.
#
# BACKEND_BASE_URL is the CONTAINER-RESOLVABLE rewrite/SSR target. It is baked
# into .next/routes-manifest.json at build time by docker-compose
# (http://gateway:3000) and is not read from this file at runtime.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8500


# -----------------------------------------------------------------------------
# Media / uploads
# -----------------------------------------------------------------------------
# Images and student photos are stored in ImageKit. ImageKit is optional at
# boot: when these are blank the services start normally and only upload
# endpoints fail, with a clear "File storage (ImageKit) is not configured"
# error. Set NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT to the same endpoint so the
# frontend can render CDN URLs.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Alerts, password resets and staff credential notices. Leave blank to disable
# sending; the app still runs.
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=ARMS360

# Brand shown in the email footer.
MAIL_SIGNATURE_BRAND=RND, Deerwalk
# Verbose SMTP logging. Keep false in production.
MAIL_DEBUG=false

# Redirect all outgoing mail here for local testing.
# MAIL_REDIRECT_TO=you@example.com


# -----------------------------------------------------------------------------
# Alerts / reminders (optional)
# -----------------------------------------------------------------------------
# These seed the alert_settings table the first time it is empty. After that the
# super-admin Alerts screen is the source of truth.
ALERT_ATTENDANCE_MORNING_ENABLED=true
ALERT_ATTENDANCE_EVENING_ENABLED=true
ALERT_EXAM_MARKS_ENABLED=true
ALERT_EXAM_MARKS_LEAD_DAYS=4
ALERT_CAS_MARKS_ENABLED=true
ALERT_CAS_MARKS_LEAD_DAYS=4
ALERT_CAS_MARKS_IDLE_WEEKS=3
# Build recipient lists and log payloads but do not SMTP-send. Recommended for
# the first deployment after the split.
ALERT_DRY_RUN=true
# Legacy switch that seeds BOTH attendance windows when they are unset.
ALERT_ATTENDANCE_REMINDER_ENABLED=true
# How many times a failed alert delivery is retried.
ALERT_DELIVERY_ATTEMPTS=3


# -----------------------------------------------------------------------------
# Bug reporting integrations (optional)
# -----------------------------------------------------------------------------
BUG_REPORT_NOTIFICATION_ENABLED=false
SLACK_BUG_REPORT_WEBHOOK_URL=
BUG_REPORT_FRONTEND_BASE_URL=http://localhost:9000
BUG_REPORT_SCREENSHOT_RETENTION_DAYS=30

GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Project number shown alongside a GitHub issue link.
GITHUB_PROJECT_NUMBER=
GITHUB_TOKEN=
GITHUB_REPO_OWNER_FRONTEND=
GITHUB_REPO_NAME_FRONTEND=

# Auto-capture HTTP 5xx responses as Failed Jobs / SYSTEM bugs. On by default
# (including production). Set false to disable.
# AUTO_CAPTURE_ENABLED=true

GOOGLE_FORMS_ENABLED=false
GOOGLE_FORMS_FORM_ID=
GOOGLE_FORMS_FIELD_MAPPING={}
GOOGLE_FORMS_FORM_ID_FRONTEND=
GOOGLE_FORMS_FIELD_MAPPING_FRONTEND={}
GOOGLE_FORMS_FORM_ID_FRONTEND_MINIMAL=
GOOGLE_FORMS_FIELD_MAPPING_FRONTEND_MINIMAL={}


# -----------------------------------------------------------------------------
# GPS tracking (optional)
# -----------------------------------------------------------------------------
TRACCAR_URL=
TRACCAR_USER=
TRACCAR_PASSWORD=

# -----------------------------------------------------------------------------
# Password reset
# -----------------------------------------------------------------------------
# Defaults to ${FRONTEND_URL}/reset-password?token=... when unset.
# FRONTEND_RESET_PASSWORD_URL=http://localhost:9000/reset-password


# -----------------------------------------------------------------------------
# Database backups (optional)
# -----------------------------------------------------------------------------
# The super-admin backup screen runs pg_dump and commits the gzipped dump to a
# private GitHub repository through the Contents API. Leave blank to disable.
DUMP_GITHUB_TOKEN=
DUMP_GITHUB_OWNER=
DUMP_GITHUB_REPO=
DUMP_GITHUB_BRANCH=main
DUMP_GITHUB_PATH=backups
DUMP_GIT_AUTHOR_NAME=ERP Backup Bot
DUMP_GIT_AUTHOR_EMAIL=noreply@deerwalk.edu.np
# Dumps older than this many days are pruned from the backup repo.
BACKUP_RETENTION_DAYS=30
